<?xml version="1.0" encoding="utf-8"?>
<!--
  云备份 / 换机迁移的排除规则。
  datastore 里存着用户自填的 API Key（已用 KeyStore 加密），
  但密文离开本机后密钥也解不开，备份出去只会增加泄漏面，
  所以整个 datastore 目录都不参与备份。
  规则见 https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
</full-backup-content>
